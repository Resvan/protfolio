---
import { Icon } from 'astro-icon/components';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
const direct = [
  { href: `mailto:${site.email}`, label: site.email, icon: 'lucide:mail', external: false },
  { href: `https://wa.me/${site.whatsapp}`, label: site.whatsappDisplay, icon: 'simple-icons:whatsapp', external: true },
  { href: site.socials.linkedin, label: 'LinkedIn', icon: 'simple-icons:linkedin', external: true },
  { href: site.socials.github, label: 'GitHub', icon: 'simple-icons:github', external: true },
];
---
<section id="contact" class="js-section reveal relative py-24 md:py-32" aria-labelledby="contact-title">
  <div class="glow pointer-events-none absolute inset-x-0 bottom-0 h-[40rem]" aria-hidden="true"></div>
  <div class="container relative">
    <div class="grid gap-12 rounded-[2rem] hairline bg-surface/80 p-8 backdrop-blur-xl md:p-14 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div>
        <p class="label"><span class="text-accent">05</span> — Contact</p>
        <h2 id="contact-title" class="mt-4 text-step-5">Let's <em>talk.</em></h2>
        <p class="mt-6 max-w-sm text-muted">Have a project, a role, or just a question? Send a message and I'll get back to you, usually within a day.</p>
        <ul class="mt-10 space-y-4">
          {direct.map((d) => (
            <li>
              <a href={d.href} class="group inline-flex items-center gap-3 text-fg" {...(d.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="inline-flex size-9 items-center justify-center rounded-full hairline bg-bg transition-colors group-hover:text-accent"><Icon name={d.icon} class="size-4" aria-hidden="true" /></span>
                <span class="label normal-case tracking-normal text-fg">{d.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <ContactForm />
    </div>
  </div>
</section>
