---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import photo from '../assets/resvan.jpg';
---
<section id="hero" class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="glow pointer-events-none absolute -top-40 right-0 h-[60rem] w-[60rem] translate-x-1/3" aria-hidden="true"></div>
  <div class="container grid min-h-[calc(100dvh-4rem)] items-center gap-14 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
    <div class="relative">
      {site.availableForFreelance && (
        <p class="label inline-flex items-center gap-2 rounded-full hairline bg-surface/60 px-3 py-1.5">
          <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:hidden"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span></span>
          Available for freelance
        </p>
      )}
      <h1 id="hero-title" class="mt-8 text-step-5">
        <span class="mb-5 flex items-center gap-3">
          <Picture src={photo} formats={['avif', 'webp']} widths={[96, 144]} sizes="48px" alt="" class="size-12 rounded-full object-cover lg:hidden" loading="eager" />
          <span class="label text-[0.8rem] normal-case tracking-[0.08em] text-fg">{site.name}</span>
        </span>
        Building <em>fast, accessible</em> web &amp; mobile products.
      </h1>
      <p class="mt-7 max-w-xl text-step-1 text-muted">
        Software engineer at <a href={site.employer.url} target="_blank" rel="noopener noreferrer" class="text-fg">{site.employer.name}</a>. {site.locationLine}.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#work" class="group inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3.5 text-step-0 font-medium text-bg transition-transform hover:-translate-y-0.5 motion-reduce:transition-none">
          View work <Icon name="lucide:arrow-down-right" class="size-4 transition-transform group-hover:rotate-45 motion-reduce:transition-none" aria-hidden="true" />
        </a>
        <a href="#contact" class="inline-flex items-center gap-2 rounded-full hairline px-6 py-3.5 text-step-0 font-medium text-fg transition-colors hover:bg-surface">Contact me</a>
      </div>
    </div>

    <div class="relative mx-auto hidden w-full max-w-sm lg:block lg:max-w-md">
      <div class="rounded-[2rem] bg-gradient-to-b from-white/15 to-transparent p-px dark:from-white/15">
        <div class="overflow-hidden rounded-[calc(2rem-1px)] bg-surface">
          <Picture
            src={photo}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1000]}
            sizes="(min-width: 1024px) 28rem, 85vw"
            alt="Portrait of Muhammed Resvan K"
            class="aspect-[4/5] w-full object-cover"
            loading="eager"
          />
        </div>
      </div>
      <p class="label absolute -bottom-4 left-6 rounded-full hairline bg-bg/90 px-4 py-2 backdrop-blur">
        {site.address.locality}, {site.address.region} · GMT+5:30
      </p>
    </div>
  </div>
</section>
