---
import { Icon } from 'astro-icon/components';
---
<button
  type="button"
  id="chat-fab"
  aria-label="Ask AI about Resvan"
  aria-haspopup="dialog"
  aria-controls="chat-panel"
  class="fixed bottom-5 right-20 z-40 inline-flex h-12 items-center gap-2 rounded-full bg-fg px-4 text-step--1 font-medium text-bg shadow-[0_8px_30px_rgba(0,0,0,0.35)] transition-transform hover:-translate-y-0.5 motion-reduce:transition-none"
  hidden
>
  <Icon name="lucide:sparkles" class="size-4" aria-hidden="true" /> Ask AI
</button>
