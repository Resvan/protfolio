---
import { Icon } from 'astro-icon/components';
---
<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-10 items-center justify-center rounded-full hairline bg-surface text-fg transition-colors hover:text-accent"
  aria-label="Switch to light theme"
  aria-pressed="false"
  data-label-dark="Switch to light theme"
  data-label-light="Switch to dark theme"
>
  <Icon name="lucide:sun" class="size-[18px] hidden [[data-theme=dark]_&]:block" aria-hidden="true" />
  <Icon name="lucide:moon" class="size-[18px] hidden [[data-theme=light]_&]:block" aria-hidden="true" />
</button>
<script src="../scripts/theme.ts"></script>
