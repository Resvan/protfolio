---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title={`Page not found | ${site.alternateName}`} description="That page doesn't exist." noindex path="/404">
  <main id="main" class="container relative flex flex-1 flex-col items-center justify-center py-32 text-center">
    <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <p class="label relative">404</p>
    <h1 class="relative mt-4 text-step-5">Nothing <em>here.</em></h1>
    <p class="relative mt-6 max-w-prose text-muted">The link may be old or mistyped. Everything about me lives on the home page.</p>
    <a href="/" class="relative mt-10 inline-flex rounded-full bg-fg px-6 py-3.5 font-medium text-bg">Back to home</a>
  </main>
</BaseLayout>
